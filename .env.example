# Example environment file for LitReview Studio
# Groq API configuration (used for AI extraction and synthesis)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
# Optional model selection; defaults to openai/gpt-oss-20b if omitted
GROQ_MODEL=openai/gpt-oss-20b
# Optional basic auth for the web UI
APP_USERNAME=slr-user
APP_PASSWORD=
